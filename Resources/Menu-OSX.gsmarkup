<?xml version="1.0"?>
<!DOCTYPE gsmarkup>
<!-- Birthday Menu for OSX
(c) 2026 - Patrick Cardona
An Agnostep Desktop Application
Under MIT License -->
<gsmarkup>
  <objects>
    <menu type="main">
      <menuItem title="Birthday">
        <menu title="Birthday" type="apple">
          <menuItem title="Events of the Day..." keyEquivalent="" action="showEvents:" />
          <menuItem title="Events of the Month..." keyEquivalent="" action="showEventsOfTheMonth:" />
      <menuItem title="Events of Next Month..." keyEquivalent="" action="showEventsOfNextMonth:" />
          <menuItem title="Quit" keyEquivalent="q" action="terminate:" />
        </menu>
      </menuItem>
      <menuItem title="Info">
        <menu title="Info" type="apple">
          <menuItem title="Info Panel..." keyEquivalent="" action="orderFrontStandardInfoPanel:" />
          <menuItem title="Help..." keyEquivalent="?" action="orderFrontHelpPanel:" />
        </menu>
      </menuItem>
    </menu>
  </objects>
</gsmarkup>
<?xml version="1.0"?>
<!DOCTYPE gsmarkup>
<!-- Birthday Window to show events
(c) 2026 - Patrick Cardona
An Agnostep Desktop Application
Under MIT License -->
<gsmarkup>

  <objects>
  
    <window title="Events" id="MainWindow" visible="no" delegate="#myDelegate">
    <vbox>
    <scrollView id="scroll">
        <textView id="message" />
    </scrollView>
    <button title="Quit" id="quit" action="terminate:" target="#NSOwner" />
    </vbox>
   </window>
   
  </objects>
  
  <connectors>
   <outlet source="#NSOwner" target="#MainWindow" key="MainWindow"/>
   <outlet source="#NSOwner" target="#scroll" key="scroll"/>
   <outlet source="#NSOwner" target="#message" key="message"/>
   <outlet source="#NSOwner" target="#closer" key="closer"/>
  </connectors>
  
</gsmarkup>
